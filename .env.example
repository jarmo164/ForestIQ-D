# Copy this file to .env and replace every development value before deployment.
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Kohalik parooli/TOTP sisselogimine töötab ainult koos DJANGO_DEBUG=true.
FORESTIQ_DEVMODE=true

# Keycloak Authorization Code + PKCE (tootmises määra kõik järgmised väärtused).
# KEYCLOAK_OIDC_ENABLED=true
# KEYCLOAK_ISSUER=https://sso.example.ee/realms/forestiq
# KEYCLOAK_CLIENT_ID=forestiq-web
# KEYCLOAK_ORGANIZATION_CLAIM=organization_id
# KEYCLOAK_SCOPES=openid profile email
# KEYCLOAK_HTTP_TIMEOUT_SECONDS=10

POSTGRES_DB=forestiq
POSTGRES_USER=forestiq
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Used only by `python manage.py import_legacy_metsis --confirm`.
# LEGACY_DATABASE_URL=postgresql://readonly_user:password@legacy-host:5432/metsis

# Optional authenticated sync sources (leave empty until credentials exist).
# FORESTEK_API_URL=https://weasel.example/api
# FORESTEK_API_TOKEN=
# PARIMUS_API_URL=https://parimus.example
# PARIMUS_API_TOKEN=
